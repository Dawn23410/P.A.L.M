# Vite 构建产物可由 npm run build / build:standalone 重建，CI 已留存 artifact
dist/
dist_new/
dist_old/
.build_*/
dist-standalone/
frontend/test-standalone.html
# tsc / vite 增量构建缓存
*.tsbuildinfo
# Vite 临时增量文件
*.timestamp-*.mjs

# ---------- 环境与密钥 ----------
# 本地环境变量可能含密钥，仅保留示例模板
.env
.env.*
!.env.example

# ---------- 运行期日志 ----------
# webview_debug.log / error.log 等非源码产物
*.log

# ---------- 工具/记忆目录 ----------
# 本机 agent 记忆与配置，含个人数据，不入库
.workbuddy/

# ---------- 系统杂项 ----------
.DS_Store
Thumbs.db
# 临时清理脚本（会话中自动生成，不入库）
.tmp_*
# 测试遗留产物（自动生成不被跟踪）
tool_test_output.txt
*.moved
# shell 适用性测试 runner 每次重跑重新生成的结果摘要，非源码
shell_test_report_brief.json
# 工具测试落盘输出目录
tool_test_dir/
# pytest 运行缓存
.pytest_cache/
# uiautomation 控件查找超时探测日志（运行期自动生成，非源码）
@AutomationLog.txt

# ---------- 上传文件落盘目录 ----------
# 运行时用户上传的文件，不入库
backend/uploads/

# ---------- 本地启动脚本（用户自定义，不入库） ----------
run.bat
test.bat

# ---------- parse 砖块运行期工作区 ----------
# 解析任务的中间产物（落盘文件、挑出的图片），不入库
backend/parse_workspace/

# ---------- Ollama 砖块运行期工作区 ----------
# 向导下载/上传的 GGUF 与 Modelfile，不入库（实际路径在 backend/app/ollama_workspace）
backend/app/ollama_workspace/
# llama.cpp 转换脚本（以子模块方式放置在 backend/llama.cpp，不入库；见 convert.py）
backend/llama.cpp/

# ---------- 加密砖块：密钥与状态（含主密钥，绝不入库） ----------
# 主密钥库、加密总开关状态、恢复密钥校验码均为本机敏感数据
backend/.crypto_keystore
backend/.crypto_state.json
backend/.recovery_checksum

# ---------- 存储池运行期数据（用户文件落盘，不入库） ----------
# 统一分类存储池目录（旧 backend/storage_pool 已废弃，新默认 Data/）
backend/storage_pool/
Data/

# ---------- 安全沙箱运行期数据（蜜罐/诱饵文件，含伪装凭据，绝不入库） ----------
# 沙箱引擎运行时生成的 decoys（.ssh/id_rsa / .aws/credentials 等伪装凭据）
# 与 .sandbox_user_pass，仅用于诱捕外泄检测，属本机敏感运行期产物。
backend/sandbox_runtime/

# ---------- Ollama catalog 运行期数据 ----------
# 模型目录清单缓存（运行时生成）
backend/app/bricks/ollama/catalog_data.py

# ---------- Windows 保留设备名残留垃圾文件 ----------
# frontend/nul 为误生成的 0 字节游离文件（Windows 设备名，无法入回收站），非源码，屏蔽
frontend/nul
nul
CON
PRN
AUX

