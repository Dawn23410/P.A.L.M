{
  "manifest": {
    "id": "sysmon",
    "name": "系统监控",
    "width": 260,
    "height": 200,
    "tier": "rich",
    "clickThrough": false,
    "permissions": ["cpu", "memory", "disk", "network"]
  },
  "html": "<div class='glass'><div class='title'>系统监控</div><div class='row'><span>CPU</span><div class='bar'><i id='cpu'></i></div><b id='cpuv'></b></div><div class='row'><span>内存</span><div class='bar'><i id='mem'></i></div><b id='memv'></b></div><div class='row'><span>磁盘</span><div class='bar'><i id='disk'></i></div><b id='diskv'></b></div><div class='net' id='net'></div></div>",
  "css": ".glass{background:rgba(255,255,255,.08);backdrop-filter:blur(16px) saturate(160%);border:1px solid rgba(255,255,255,.25);border-radius:16px;padding:14px 16px;color:#eaf2ff;box-shadow:0 8px 30px rgba(0,0,0,.35)}.title{font-size:15px;opacity:.8;margin-bottom:10px}.row{display:flex;align-items:center;gap:8px;margin:8px 0;font-size:13px}.row span{width:34px}.bar{flex:1;height:8px;background:rgba(255,255,255,.15);border-radius:6px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#4ade80,#22d3ee);transition:width .6s}.row b{width:42px;text-align:right;font-variant-numeric:tabular-nums}.net{margin-top:8px;font-size:12px;opacity:.7}",
  "js": "function setBar(id,pct){document.getElementById(id).style.width=pct+'%';}PALM.onTick(1500, function(s){setBar('cpu',s.cpu.usage);document.getElementById('cpuv').textContent=s.cpu.usage+'%';setBar('mem',s.memory.percent);document.getElementById('memv').textContent=s.memory.percent+'%';setBar('disk',s.disk.percent);document.getElementById('diskv').textContent=s.disk.percent+'%';document.getElementById('net').textContent='↑'+s.network.sent_mb+'MB ↓'+s.network.recv_mb+'MB';});"
}
