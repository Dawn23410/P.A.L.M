{
  "manifest": {
    "id": "clock",
    "name": "时钟",
    "width": 220,
    "height": 90,
    "tier": "lite",
    "clickThrough": false,
    "permissions": ["time"]
  },
  "html": "<div class='clock'><div id='t'>--:--:--</div><div id='d'>----/--/--</div></div>",
  "css": ".clock{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#eaf2ff;text-shadow:0 2px 8px rgba(0,0,0,.5)}#t{font-size:34px;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:1px}#d{font-size:13px;opacity:.75;margin-top:2px}",
  "js": "function pad(n){return (n<10?'0':'')+n;}PALM.onTick(1000,function(s){var t=s.time;var el=document.getElementById('t');var de=document.getElementById('d');if(!t||!el)return;el.textContent=pad(t.hour)+':'+pad(t.minute)+':'+pad(t.second);if(de)de.textContent=t.date;});"
}
