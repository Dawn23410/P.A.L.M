# P.A.L.M 后端环境配置（可选；复制为 .env 后覆盖默认值）
# 不填则使用下方默认值，应用可直接启动。

# 服务监听地址与端口
HOST=127.0.0.1
PORT=8000

# 允许跨域的来源（开发浏览器 / PyWebView / 静态托管）
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ── QwenTTS 语音合成（可选；未配置时优雅降级，语音合成仍可用 tts_sovits）──
# 指向本地 qwen-tts 服务；留空则 QWEN_TTS_AUTO_LAUNCH=True 时自动拉起 serve.py（需已部署 .venv-qwen-tts 与模型）。
QWEN_TTS_API_URL=http://127.0.0.1:19300
# 自动拉起本地 serve.py（仅当 QWEN_TTS_API_URL 未配置时生效）
QWEN_TTS_AUTO_LAUNCH=true
# 本地模型目录（serve.py 加载权重；留空则回退 HuggingFace 缓存/自动下载）
# 默认 VoiceDesign 模型：Qwen3-TTS-12Hz-1.7B-VoiceDesign（instruct 文本描述直接生成音色）
QWEN_TTS_MODEL_DIR=C:/Users/24459/Desktop/P.A.L.M/Data/qwen_tts_voicedesign
# 模型标识：VoiceDesign（默认，文本造音色）| CustomVoice（9 内置音色）| Base（few-shot 克隆）
# QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign
# 量化档位：4bit（默认 NF4，约 2GB 显存，4G 卡可跑）| 8bit | off
# QWEN_TTS_QUANTIZE=4bit
# 自定义参考音频/音色目录（few-shot：<name>.wav + <name>.txt；Base 模型克隆用）
# QWEN_TTS_VOICES_DIR=

# ── STT 语音识别（内置砖 stt；推理引擎跑在独立 venv .venv-stt 的独立子进程）──
# 依赖安装：python backend/app/bricks/stt/install.py
# 模型放 Data/stt_models/{vad,kws,asr}/；缺模型时优雅降级（/api/stt/status 报缺失，不阻断启动）。
STT_ENABLED=false
STT_AUTO_LAUNCH=true
STT_API_URL=http://127.0.0.1:19500
# 采样率固定 16kHz 单声道（与 Silero VAD / Zipformer ASR 训练配置一致）
STT_SAMPLE_RATE=16000
# 模型路径（默认按 Data/stt_models/ 约定目录探测）
# STT_VAD_MODEL=C:/Users/24459/Desktop/P.A.L.M/Data/stt_models/vad/silero_vad.onnx
# STT_ASR_MODEL=C:/Users/24459/Desktop/P.A.L.M/Data/stt_models/asr
# STT_KWS_MODEL=C:/Users/24459/Desktop/P.A.L.M/Data/stt_models/kws
# STT_KWS_KEYWORDS=C:/Users/24459/Desktop/P.A.L.M/Data/stt_models/kws/keywords.txt
# STT_VENV_PYTHON=

# ── GSV 语音合成（内置砖 tts_sovits；推理引擎跑在独立 venv .venv-gsv 的子进程）──
# 运行时 .venv-gsv 已装（torch cu128 + transformers<=4.50），权重已内聚进砖
# （src/GPT_SoVITS/pretrained_models/）。以下变量在 palm_sdk/core/config.py 已有
# 指向砖内源码/权重的安全默认值，留空即可开箱即用；此处列出供覆盖。
# SOVITS_ROOT=C:/Users/24459/Desktop/P.A.L.M/语音合成 (GPT-SoVITS)/src
# SOVITS_API_URL=http://127.0.0.1:9880
# SOVITS_API_PORT=9880
# SOVITS_API_ROUTE=/
# SOVITS_INFER_DEVICE=cuda
# SOVITS_SOVITS_MODEL=GPT_SoVITS/pretrained_models/gsv-v2final-pretrained/s2G2333k.pth
# SOVITS_GPT_MODEL=GPT_SoVITS/pretrained_models/gsv-v2final-pretrained/s1bert25hz-5kh-longer-epoch=12-step=369668.ckpt
# SOVITS_HUBERT_DIR=GPT_SoVITS/pretrained_models/chinese-hubert-base
# SOVITS_BERT_DIR=GPT_SoVITS/pretrained_models/chinese-roberta-wwm-ext-large
# SOVITS_DEFAULT_REFER_WAV=gpt_sovits/ref_audio.wav
# SOVITS_DEFAULT_REFER_TEXT=你好，我是语音助手。
# SOVITS_DEFAULT_REFER_LANG=zh

