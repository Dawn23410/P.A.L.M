{
  "project": "P.A.L.M",
  "fullName": "Parameter Administration & Lifecycle Manager",
  "description": "桌面 AI 模块化平台的后端参数配置与生命周期管理中心",
  "createdAt": "2026-06-16",
  "lastUpdated": "2026-06-24",
  "type": "desktop-module-console",
  "title": "P.A.L.M",
  "techStack": {
    "frontend": {
      "framework": "React 18",
      "buildTool": "Vite 5",
      "language": "TypeScript 5.6",
      "uiLibrary": "Ant Design 5.21",
      "stateManagement": "zustand 4.5",
      "router": "react-router-dom 6",
      "chartLibrary": "@ant-design/charts",
      "httpClient": "fetch (原生)"
    },
    "backend": {
      "moduleManager": "Python FastAPI + uvicorn (端口 9090)",
      "performanceMonitor": "Python FastAPI + psutil + pynvml (端口 8080)",
      "runtimeServer": "Python FastAPI (端口 5000)",
      "ttsEngines": {
        "qwen3Tts": "FastAPI + Qwen3 (端口 8000)",
        "gptSoVits": "GPT-SoVITS API (端口 9880)"
      },
      "archiveTool": "py7zr (LZMA2)"
    },
    "persistence": "localStorage (500ms 防抖)"
  },
  "modules": [
    { "id": "dashboard", "name": "仪表盘", "route": "/dashboard", "status": "implemented" },
    { "id": "modules", "name": "模块管理", "route": "/modules", "status": "implemented" },
    { "id": "tts", "name": "语音合成", "route": "/tts", "status": "implemented" },
    { "id": "wallpaper", "name": "壁纸引擎", "route": "/wallpaper", "status": "planned" },
    { "id": "dock", "name": "Dock栏", "route": "/dock", "status": "planned" },
    { "id": "agent", "name": "Agent", "route": "/agent", "status": "planned" },
    { "id": "asr", "name": "语音识别", "route": "/asr", "status": "planned" }
  ],
  "ttsPages": [
    { "id": "tts-main", "name": "TTS 主页面", "route": "/tts", "engine": "both" },
    { "id": "tts-custom-voice", "name": "Qwen3-TTS 语音合成", "route": "/tts/custom-voice", "engine": "qwen3-tts" },
    { "id": "tts-voice-design", "name": "Qwen3-TTS 音色设计", "route": "/tts/voice-design", "engine": "qwen3-tts" },
    { "id": "tts-voice-clone", "name": "Qwen3-TTS 语音克隆", "route": "/tts/voice-clone", "engine": "qwen3-tts" },
    { "id": "gs-basic", "name": "GPT-SoVITS 基础配置", "route": "/tts/gs-basic", "engine": "gpt-sovits" },
    { "id": "gs-advanced", "name": "GPT-SoVITS 高级参数", "route": "/tts/gs-advanced", "engine": "gpt-sovits" },
    { "id": "gs-clone", "name": "GPT-SoVITS 语音克隆", "route": "/tts/gs-clone", "engine": "gpt-sovits" }
  ],
  "formComponentsUsed": {
    "wallpaper": [
      "滑块 (Slider)", "复选框 (Checkbox/Switch)", "下拉选择框 (Select)",
      "颜色选择器 (ColorPicker)", "文本输入框 (Input)", "文件选择器 (Upload)",
      "带标题的分组边框或折叠面板 (Card/Collapse)", "按钮 (Button)"
    ],
    "dock": [
      "颜色选择器 (ColorPicker)", "滑块 (Slider)", "下拉选择框 (Select)",
      "开关 (Switch)", "文件选择器 (Upload)", "数字输入框 (InputNumber)",
      "按钮 (Button)", "快捷键捕获器 (HotkeyCapture - 自定义)"
    ],
    "agent": [
      "下拉选择框 (Select) - API供应商/AI模型/网关连接模式",
      "密码输入框 (Input.Password) - API Key",
      "文本输入框 (Input) - API端点URL/自定义模型路径/认证令牌",
      "数字输入框 (InputNumber) - 请求超时时间(秒)",
      "开关 (Switch) - 启用/禁用通讯集成(微信/企业微信/Telegram/Email/Slack)",
      "按钮 (Button) - 安装/启动/保存配置",
      "选项卡 (Tabs) - 模型/记忆/外观/聊天分类",
      "列表/表格 (List/Table) - 已启用的技能和工具/Sessions管理"
    ],
    "asr": [
      "按钮 (Button)", "输入框 (Input)", "下拉框 (Select)", "复选框 (Checkbox)",
      "单选钮 (Radio)", "滑块 (Slider)", "开关 (Switch)",
      "颜色选择器 (ColorPicker)", "文件选择器 (Upload)",
      "标签页 (Tabs)", "折叠面板 (Collapse)"
    ],
    "tts": [
      "文本 (Input/TextArea)", "下拉框 (Select)", "滑块 (Slider)", "按钮 (Button)",
      "开关 (Switch)", "文件选择器 (Upload)", "标签页 (Tabs)", "列表 (List)",
      "对话框 (Modal)", "通知 (Notification/Message)", "数字输入框 (InputNumber)",
      "颜色选择器 (ColorPicker)"
    ]
  },
  "navigation": "侧边栏分组导航（固定 240px）",
  "dataStructure": "扁平路由 + configSchema 单点真相",
  "persistence": {
    "localStorage": true,
    "autoSave": true,
    "debounce": 500,
    "exportImportJSON": false,
    "resetToDefault": true
  },
  "dashboard": "系统性能图表（CPU/内存/GPU/网络/磁盘）+ 模块状态概览 + 交互式控制台",
  "theme": {
    "modes": ["亮色", "暗色"],
    "default": "跟随系统",
    "implementation": "CSS 变量 + themeStore (zustand)"
  },
  "api": {
    "hasBackend": true,
    "dataFormat": "JSON",
    "accessMode": "仅本地地址 (127.0.0.1)",
    "mockMode": false,
    "services": {
      "moduleManager": {
        "port": 9090,
        "baseUrl": "http://127.0.0.1:9090",
        "auth": "none"
      },
      "performanceMonitor": {
        "port": 8080,
        "baseUrl": "http://127.0.0.1:8080",
        "auth": "none"
      },
      "runtimeServer": {
        "port": 5000,
        "baseUrl": "http://127.0.0.1:5000",
        "auth": "none"
      },
      "ttsQwen3": {
        "port": 8000,
        "baseUrl": "http://127.0.0.1:8000",
        "auth": "none"
      },
      "ttsGptSoVits": {
        "port": 9880,
        "baseUrl": "http://127.0.0.1:9880",
        "auth": "none"
      }
    },
    "auth": "none"
  },
  "modulePackageSpec": {
    "format": "7z (LZMA2, -mx=9)",
    "requiredManifestFields": ["module", "version", "type", "description", "entry"],
    "optionalManifestFields": ["author", "dependencies", "config", "deploy"],
    "moduleTypes": ["backend", "frontend", "service", "tool"],
    "installSteps": 6,
    "rollbackOnFailure": true,
    "security": ["Zip Slip 防护", "SHA-256 完整性检测", "原子回滚"]
  },
  "ports": [
    { "service": "Vite 前端 Dev Server", "port": 43210 },
    { "service": "模块管理 API", "port": 9090 },
    { "service": "palm-backend 性能监控", "port": 8080 },
    { "service": "GSV Runtime Server", "port": 5000 },
    { "service": "GPT-SoVITS TTS", "port": 9880 },
    { "service": "Qwen3-TTS API", "port": 8000 }
  ],
  "architecture": {
    "pattern": "多后端微服务 + 前端直连",
    "gateway": false,
    "frontendDirectAccess": true,
    "stateManagement": "前端 localStorage 持久化（不依赖后端）"
  }
}
